<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.selfcheckout</groupId>
    <artifactId>service-based</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>service-based</name>
    <description>Service-based (coarse-grained domain services) implementation of the self-checkout API</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <!--
      Coarse-grained domain services + one shared persistence library.
      Each service module builds an independently deployable Spring Boot jar
      (and a Docker image); shared-persistence is a thin library carrying ONLY
      the data-access coupling surface (the tables touched by >1 service).
    -->
    <modules>
        <module>shared-persistence</module>
        <module>catalog-service</module>
        <module>checkout-service</module>
        <module>analytics-service</module>
    </modules>

</project>
